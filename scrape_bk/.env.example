# LLM / Vision-Language Model Configuration (Qwen2.5-VL / Qwen2.5-Coder via vLLM or Ollama)
QWEN_API_BASE=http://localhost:8000/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL_NAME=Qwen/Qwen2.5-VL-72B-Instruct
QWEN_TEMPERATURE=0.1

# System-1 Decision Engine Configuration
# DECISION_ENGINE: 'laya' (Apache 2.0 Open-Source, $0.00 token cost) or 'jev' (TypeSafe cloud API)
DECISION_ENGINE=laya
LAYA_MODEL_PATH=convaiinnovations/laya
LAYA_MIN_VIRALITY=0.60
LAYA_MAX_SLOP=0.45

# Optional: TypeSafe Jev AI (Cloud API fallback, leave blank to use free local Laya)
TYPESAFE_API_KEY=


# Headless & Automation Settings
HEADLESS=false
BROWSER_TIMEOUT_MS=30000

# Residential Proxy Configuration
# Supported providers: 'smartproxy', 'iproyal', 'webshare', or 'custom'
PROXY_PROVIDER=smartproxy
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_COUNTRY=us
PROXY_SESSION_DURATION_MINS=30

# Optional manual overrides (leave blank to use provider defaults):
# PROXY_HOST=
# PROXY_PORT=
# PROXY_SERVER=


# Session State Storage
SESSIONS_DIR=./sessions
